{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "example/clean",
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@example/mcp-server",
      "version": "1.2.3",
      "transport": {"type": "stdio"},
      "environmentVariables": [{"name": "MCP_TOKEN", "description": "runtime secret", "isSecret": true}]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.example.test/v1",
      "headers": [{"name": "Authorization", "description": "OAuth bearer", "isSecret": true}]
    }
  ]
}
